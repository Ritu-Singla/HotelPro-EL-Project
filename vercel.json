{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://hotelpro-el-project.onrender.com/api/v1/$1"
    },
    {
      "source": "/health",
      "destination": "https://hotelpro-el-project.onrender.com/health"
    },
    {
      "source": "/api/health",
      "destination": "https://hotelpro-el-project.onrender.com/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}d
